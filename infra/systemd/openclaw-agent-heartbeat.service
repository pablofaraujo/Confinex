[Unit]
Description=Heartbeat e autorreparo dos agentes e canais OpenClaw
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=-/root/.openclaw/gateway.systemd.env
EnvironmentFile=-/root/.openclaw/secrets/whatsapp-health.env
Environment=HOME=/root
Environment=TMPDIR=/tmp
Environment=PATH=/root/.bun/bin:/usr/bin:/root/.local/bin:/root/.npm-global/bin:/root/bin:/root/.nix-profile/bin:/usr/local/bin:/bin:/snap/node/11315/bin
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
ExecStart=/usr/bin/python3 /root/ponte/tools/verificar_openclaw_canais.py --reparar --espera-reparo 15
TimeoutStartSec=240s
