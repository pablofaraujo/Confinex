[Unit]
Description=Atualiza e concilia historico privado do WhatsApp do Wey
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStartPre=-/usr/bin/systemctl stop wey-whatsapp-live-sync.service
ExecStartPre=/root/ponte/tools/sincronizar_wacli_com_retry.sh
ExecStartPre=/usr/bin/python3 /root/ponte/tools/gerar_duvidas_whatsapp.py --base /root/.openclaw/workspace-wey/private/duvidas-consolidacao.json --saida /root/.openclaw/workspace-wey/private/duvidas-whatsapp-rotina.json --janela-dias 180
ExecStart=/usr/bin/timeout --signal=TERM --kill-after=30s 20m /usr/bin/python3 /root/ponte/tools/orquestrar_conciliacao_whatsapp.py --duvidas /root/.openclaw/workspace-wey/private/duvidas-whatsapp-rotina.json --sessions-dir /root/.openclaw/agents/wey/sessions --sessions-index /root/.openclaw/workspace-wey/private/sessoes-wey.json --wacli-bin /usr/local/bin/wacli --wacli-store /root/.local/state/wacli-confinex --conciliador /root/ponte/tools/conciliar_whatsapp_pix.py --saida-conciliacao-json /root/.openclaw/workspace-wey/private/conciliacao-whatsapp-pix.json --saida-conciliacao-md /root/.openclaw/workspace-wey/private/conciliacao-whatsapp-pix.md --saida-orquestracao /root/.openclaw/workspace-wey/private/orquestracao-whatsapp.json --estado /root/.openclaw/workspace-wey/private/estado-orquestracao-whatsapp.json --executar-backfill --max-backfills 6 --requisicoes 2 --quantidade 50 --espera 45s
ExecStopPost=/root/ponte/tools/retomar_wacli_continuo.sh
SuccessExitStatus=124 143
TimeoutStartSec=26m
TimeoutStopSec=150s
